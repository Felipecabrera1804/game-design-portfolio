---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MechanicMap from '../../components/MechanicMap.astro';
import { getProjects, statusLabel, url } from '../../utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const facts = [
  ['Role', p.role],
  ['Team', p.team],
  ['Duration', p.duration],
  ['Type', `${statusLabel[p.status]} · ${p.year}`],
  ['Tools', p.tools.join(', ')],
].filter(([, v]) => v);
---
<Base title={p.title} description={p.tagline}>
  <article>
    <header class="wrap head">
      <a class="back" href={url('/projects/')}>← All work</a>
      <h1>{p.title}</h1>
      <p class="tagline">{p.tagline}</p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="actions">
        {p.playUrl && <a class="btn" href={p.playUrl} target="_blank" rel="noopener">▶ Play it</a>}
        {p.videoUrl && <a class="btn ghost" href={p.videoUrl} target="_blank" rel="noopener">Watch video</a>}
        {p.docsUrl && <a class="btn ghost" href={p.docsUrl} target="_blank" rel="noopener">Design doc</a>}
      </div>
    </header>

    <div class="wrap"><img class="cover" src={url(p.cover.src)} alt={p.cover.alt} /></div>

    <div class="wrap body">
      <section class="question">
        <p class="eyebrow">The design question</p>
        <p class="q">{p.designQuestion}</p>
      </section>

      <section>
        <p class="eyebrow">Mechanics ↔ narrative</p>
        <MechanicMap rows={p.mechanicMap} />
      </section>

      <div class="prose"><Content /></div>
    </div>

    {next && next.id !== project.id && (
      <nav class="wrap next" aria-label="Next project">
        <a href={url(`/projects/${next.id}/`)}>
          <span class="eyebrow">Next project</span>
          <span class="t">{next.data.title} →</span>
        </a>
      </nav>
    )}
  </article>
</Base>

<style>
  .head { padding-top: 48px; }
  .back { font-size: .9rem; color: var(--muted); text-decoration: none; }
  .head h1 { margin-top: 20px; }
  .tagline { font-size: 1.25rem; color: var(--muted); max-width: 60ch; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px 28px; margin: 28px 0; padding: 20px 0; border-block: 1px solid var(--line); }
  .facts dt { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .facts dd { margin: 2px 0 0; font-size: .95rem; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); margin: 40px 0 0; border: 1px solid var(--line); }
  .body { padding-block: 48px; max-width: calc(var(--prose) + 240px); }
  .question { margin-bottom: 40px; }
  .q { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.3; max-width: 32ch; margin-top: 8px; }
  .next { padding-bottom: 40px; }
  .next a { display: block; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); text-decoration: none; }
  .next a:hover { border-color: var(--accent); }
  .next .t { display: block; font-family: var(--font-display); font-size: 1.6rem; margin-top: 4px; }
</style>
