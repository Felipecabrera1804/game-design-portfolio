---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../utils';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---
<Base title="Work" description="Game and narrative design projects.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1>Projects</h1>
      <p class="lede">Each project is written as a case study: the design question, how the mechanics carry the story, the process, and what I learned.</p>

      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>

      {others.length > 0 && (
        <>
          <div class="chapter sub"><span class="num">Also</span><h2>Smaller experiments & jams</h2></div>
          <div class="list">{others.map((p) => <ProjectCard project={p} variant="compact" />)}</div>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .lede { color: var(--muted); max-width: 60ch; font-size: 1.1rem; margin-bottom: 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 28px; }
  .sub { margin-top: 64px; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 18px; }
  @media (max-width: 600px) { .grid, .list { grid-template-columns: 1fr; } }
</style>
