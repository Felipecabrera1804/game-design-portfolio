---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { url } from '../utils';
---
<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <section class="section">
    <div class="wrap about">
      <div>
        <p class="eyebrow">About</p>
        <h1>Hi, I'm {site.name.split(' ')[0]}.</h1>
        <div class="prose">
          <!-- TODO: rewrite in your own voice. Keep it short: who you are, what you believe about narrative + mechanics, what you're looking for. -->
          <p>
            I'm a game designer focused on narrative experiences where the mechanics and the story say the same thing.
            I care about the moment a player understands a theme through doing something, without being told about it.
          </p>
          <h2>How I design</h2>
          <ul>
            <li><strong>Start from the feeling.</strong> I name the emotion I want the player to own, then look for the verb that produces it.</li>
            <li><strong>Prototype the meaning early.</strong> Paper and greybox tests check whether the mechanic says what I think it says.</li>
            <li><strong>Cut what contradicts.</strong> If a system tells a different story than the script, one of them has to change.</li>
          </ul>
          <h2>Currently</h2>
          <p>Looking for narrative, game or systems design roles, and always up for jams and collaborations.</p>
        </div>
      </div>
      <aside class="side">
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
        <ul>
          {site.links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 1fr 240px; gap: 56px; align-items: start; }
  .side { position: sticky; top: 96px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .side ul { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 8px; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .side { position: static; } }
</style>
