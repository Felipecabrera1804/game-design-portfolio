---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { url } from '../utils';
---
<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <section class="section">
    <div class="wrap about">
      <div>
        <p class="eyebrow">About</p>
        <h1>Hi, I'm {site.name.split(' ')[0]}.</h1>
        <div class="prose">
          <p>[Placeholder: a short introduction. Who you are, your background (studies, experience), and what draws you to narrative design. 2–3 sentences.]</p>
          <h2>How I design</h2>
          <ul>
            <li>[Placeholder: a principle or habit in your design process, in one line.]</li>
            <li>[Placeholder: another principle, ideally one your projects demonstrate.]</li>
            <li>[Placeholder: a third principle, or delete this item.]</li>
          </ul>
          <h2>Currently</h2>
          <p>[Placeholder: what you're working on or studying now, and what kind of roles or collaborations you're looking for.]</p>
        </div>
      </div>
      <aside class="side">
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
        <ul>
          {site.links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 1fr 240px; gap: 56px; align-items: start; }
  .side { position: sticky; top: 96px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .side ul { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 8px; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .side { position: static; } }
</style>
