---
import '../styles/global.css';
import { site } from '../site';
import { url } from '../utils';

interface Props { title?: string; description?: string; }
const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Work' },
  { href: '/notes/', label: 'Notes' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')}>{site.name}</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={url(n.href)} aria-current={path.startsWith(url(n.href)) ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="theme" type="button" aria-label="Toggle dark mode">◐</button>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p>{site.name} — {site.role}</p>
        <p class="links">
          <a href={`mailto:${site.email}`}>Email</a>
          {site.links.map((l) => <a href={url(l.href)}>{l.label}</a>)}
        </p>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: var(--surface); padding: 8px 12px; z-index: 10; }
  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; text-decoration: none; white-space: nowrap; }
  nav { display: flex; align-items: center; gap: 20px; font-size: .95rem; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a[aria-current='page'], nav a:hover { color: var(--text); }
  .theme { background: none; border: 1px solid var(--line); color: var(--text); width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 1rem; }
  .site-footer { border-top: 1px solid var(--line); margin-top: 40px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 28px; color: var(--muted); font-size: .9rem; }
  .foot p { margin: 0; }
  .links { display: flex; gap: 16px; flex-wrap: wrap; }
  @media (max-width: 520px) { nav { gap: 12px; font-size: .9rem; } .brand { font-size: 1rem; } }
</style>
