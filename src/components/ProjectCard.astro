---
import type { CollectionEntry } from 'astro:content';
import { url, statusLabel } from '../utils';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'hero' | 'standard' | 'compact';
  /** Hero only: put the image on the right. */
  reverse?: boolean;
}
const { project, variant = 'standard', reverse = false } = Astro.props;
const p = project.data;
const href = url(`/projects/${project.id}/`);
const firstMap = p.mechanicMap[0];
---
<article class:list={['card', variant, { reverse }]}>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    <img src={url(p.cover.src)} alt="" loading={variant === 'hero' ? 'eager' : 'lazy'} />
  </a>
  <div class="body">
    <p class="eyebrow">{statusLabel[p.status]} · {p.year} · {p.role}</p>
    <h3><a href={href}>{p.title}</a></h3>
    <p class="tagline">{p.tagline}</p>
    {variant === 'hero' && (
      <div class="map" aria-label="Core mechanic and its meaning">
        <span class="m">{firstMap.mechanic}</span>
        <span class="arrow" aria-hidden="true">→</span>
        <span class="n">{firstMap.meaning}</span>
      </div>
    )}
    {variant !== 'compact' && p.tags.length > 0 && (
      <ul class="tags">{p.tags.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
    )}
    {variant === 'hero' && <a class="btn" href={href}>Read the case study</a>}
  </div>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: border-color .2s, transform .2s; }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .media { display: block; aspect-ratio: 16 / 9; background: var(--surface-2); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; }
  .body > * { margin: 0; }
  h3 a { text-decoration: none; }
  .tagline { color: var(--muted); }

  .hero { display: grid; grid-template-columns: 1.25fr 1fr; }
  .hero .media { aspect-ratio: auto; min-height: 340px; }
  .hero .body { padding: 36px; justify-content: center; gap: 14px; }
  .hero h3 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .hero .btn { align-self: flex-start; margin-top: 6px; }
  .hero.reverse { grid-template-columns: 1fr 1.25fr; }
  .hero.reverse .media { order: 2; }
  .map { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 12px 14px; background: var(--accent-soft); border-radius: 10px; font-size: .92rem; }
  .map .m { font-weight: 600; }
  .map .arrow { color: var(--accent); }

  .compact { flex-direction: row; }
  .compact .media { width: 38%; flex-shrink: 0; aspect-ratio: auto; }
  .compact .body { padding: 16px 18px; gap: 6px; }
  .compact h3 { font-size: 1.1rem; }
  .compact .tagline { font-size: .92rem; }

  @media (max-width: 820px) {
    .hero, .hero.reverse { grid-template-columns: 1fr; }
    .hero.reverse .media { order: 0; }
    .hero .media { min-height: 0; aspect-ratio: 16 / 9; }
    .hero .body { padding: 24px; }
  }
  @media (max-width: 520px) {
    .compact { flex-direction: column; }
    .compact .media { width: 100%; aspect-ratio: 16 / 9; }
  }
</style>
